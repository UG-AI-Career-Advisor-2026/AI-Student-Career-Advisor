@page "/"

<PageTitle>CareerIQ – Home</PageTitle>

<h1>Welcome to CareerIQ</h1>
<p class="lead">
    CareerIQ helps students explore career paths that fit their skills and
    interests. Build your profile and complete the assessment to see
    personalised recommendations and a learning roadmap.
</p>

<div class="row g-3 mt-2">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">1. Build your profile</h2>
                <p class="card-text">Tell us about your programme, interests, and skills.</p>
                <a class="btn btn-primary" href="student-profile">Go to Student Profile</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">2. Take the assessment</h2>
                <p class="card-text">Answer a short set of questions about your strengths and preferences.</p>
                <a class="btn btn-primary" href="career-assessment">Go to Career Assessment</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">3. Review recommendations</h2>
                <p class="card-text">See career paths that match your profile once the assessment is complete.</p>
                <a class="btn btn-primary" href="recommendations">Go to Recommendations</a>
            </div>
        </div>
    </div>
</div>
