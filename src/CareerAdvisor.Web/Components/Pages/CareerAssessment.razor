@page "/assessment"
@page "/career-assessment"
@rendermode InteractiveServer
@inject CareerAdvisor.Core.Interfaces.IAssessmentService AssessmentService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage
@using CareerAdvisor.Core.Models
@using CareerAdvisor.Core.Validators

<PageTitle>Career Assessment</PageTitle>

<div class="container mt-4">
    <h2>Career Assessment</h2>

    @if (_isLoading)
    {
        <p>Loading assessment...</p>
    }
    else if (_isCompleted)
    {
        <div class="alert alert-success" role="alert">
            ✅ <strong>Assessment completed and saved successfully!</strong>
            Your responses have been stored safely. Refreshing the page will not lose them.
        </div>
        <p>Career recommendations will become available once the ML module is integrated.</p>
        <button class="btn btn-secondary" @onclick="StartNewAssessment">Start a new assessment</button>
    }
    else if (_session != null && _questions.Any())
    {
        var currentQuestion = _questions[_currentIndex];
        var totalQuestions = _questions.Count;

        <div class="mb-4">
            <span class="badge bg-primary">@currentQuestion.Category</span>
            <p class="text-muted mt-2 mb-1">Question @(_currentIndex + 1) of @totalQuestions</p>
            <div class="progress" style="height: 20px;">
                <div class="progress-bar" role="progressbar"
                     style="width: @(((double)(_currentIndex + 1) / totalQuestions) * 100)%"
                     aria-valuenow="@(_currentIndex + 1)" aria-valuemin="0" aria-valuemax="@totalQuestions">
                    @(((double)(_currentIndex + 1) / totalQuestions) * 100)%
                </div>
            </div>
        </div>

        <fieldset class="mb-4">
            <legend class="h5">
                @currentQuestion.Text
                @if (currentQuestion.IsRequired)
                {
                    <span class="text-danger">*</span>
                }
            </legend>

            <div class="form-check-group">
                @foreach (var option in currentQuestion.Options)
                {
                    var isSelected = _selectedOptionIds.ContainsKey(currentQuestion.Id) &&
            _selectedOptionIds[currentQuestion.Id] == option.Id;
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="question_@currentQuestion.Id" id="option_@option.Id"
                               checked="@isSelected" @onchange="() => SelectOption(currentQuestion.Id, option.Id)" />
                        <label class="form-check-label" for="option_@option.Id">
                            @option.Value
                        </label>
                    </div>
                }
            </div>
        </fieldset>

        @if (!string.IsNullOrEmpty(_validationMessage))
        {
            <div class="alert alert-danger" role="alert" aria-live="polite">
                @_validationMessage
            </div>
        }

        <div class="d-flex justify-content-between">
            <button class="btn btn-secondary" disabled="@(_currentIndex == 0)" @onclick="GoToPrevious">
                Previous
            </button>

            @if (_currentIndex < totalQuestions - 1)
            {
                <button class="btn btn-primary" @onclick="GoToNext">
                    Next
                </button>
            }
            else
            {
                <button class="btn btn-success" @onclick="SubmitAssessment">
                    Submit Assessment
                </button>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning">No assessment questions found. Please contact support.</div>
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _isCompleted = false;
    private AssessmentSession? _session;
    private List<AssessmentQuestion> _questions = new();
    private int _currentIndex = 0;
    private string _validationMessage = string.Empty;

    // Store selected options: Key = QuestionId, Value = OptionId
    private Dictionary<Guid, Guid> _selectedOptionIds = new();

    private const string SessionIdKey = "CurrentAssessmentSessionId";

    // Dummy student profile ID (replace with actual logged-in user ID if you have auth)
    private Guid _studentProfileId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    protected override void OnInitialized()
    {
        // Safe during prerender: no JavaScript interop here
        _questions = AssessmentService.GetAllQuestions().OrderBy(q => q.DisplayOrder).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // ProtectedSessionStorage needs JavaScript, so it must run after the first render
        if (firstRender)
        {
            await LoadSessionAsync();
            StateHasChanged();
        }
    }

    private async Task LoadSessionAsync()
    {
        var sessionIdResult = await SessionStorage.GetAsync<Guid>(SessionIdKey);

        if (sessionIdResult.Success && sessionIdResult.Value != Guid.Empty)
        {
            _session = AssessmentService.GetAssessmentSession(sessionIdResult.Value);

            if (_session != null)
            {
                if (_session.Status == "Completed")
                {
                    _isCompleted = true;
                }
                else
                {
                    var responses = AssessmentService.GetSessionResponses(_session.Id);
                    foreach (var response in responses)
                    {
                        _selectedOptionIds[response.QuestionId] = response.OptionId;
                    }
                }
            }
        }

        if (_session == null)
        {
            _session = AssessmentService.CreateAssessmentSession(_studentProfileId);
            await SessionStorage.SetAsync(SessionIdKey, _session.Id);
        }

        _isLoading = false;
    }

    private void SelectOption(Guid questionId, Guid optionId)
    {
        _selectedOptionIds[questionId] = optionId;
        _validationMessage = string.Empty;
    }

    private async Task GoToNext()
    {
        var currentQuestion = _questions[_currentIndex];

        if (currentQuestion.IsRequired && !_selectedOptionIds.ContainsKey(currentQuestion.Id))
        {
            _validationMessage = "This question is required. Please select an option to continue.";
            return;
        }

        if (_selectedOptionIds.TryGetValue(currentQuestion.Id, out var optionId))
        {
            var result = AssessmentService.SubmitResponse(_session!, currentQuestion.Id, optionId);
            if (!result.IsValid)
            {
                _validationMessage = string.Join(" ", result.Errors);
                return;
            }
        }

        _currentIndex++;
        _validationMessage = string.Empty;
    }

    private void GoToPrevious()
    {
        if (_currentIndex > 0)
        {
            _currentIndex--;
            _validationMessage = string.Empty;
        }
    }

    private async Task SubmitAssessment()
    {
        var currentQuestion = _questions[_currentIndex];

        if (currentQuestion.IsRequired && !_selectedOptionIds.ContainsKey(currentQuestion.Id))
        {
            _validationMessage = "This question is required. Please select an option to continue.";
            return;
        }

        if (_selectedOptionIds.TryGetValue(currentQuestion.Id, out var optionId))
        {
            var result = AssessmentService.SubmitResponse(_session!, currentQuestion.Id, optionId);
            if (!result.IsValid)
            {
                _validationMessage = string.Join(" ", result.Errors);
                return;
            }
        }

        var completionResult = AssessmentService.CompleteAssessmentSession(_session!);
        if (completionResult.IsValid)
        {
            _isCompleted = true;
            await SessionStorage.SetAsync(SessionIdKey, _session!.Id);
        }
        else
        {
            _validationMessage = "Could not complete assessment: " + string.Join(" ", completionResult.Errors);
        }
    }

    private async Task StartNewAssessment()
    {
        _isCompleted = false;
        _currentIndex = 0;
        _selectedOptionIds.Clear();
        _validationMessage = string.Empty;

        _session = AssessmentService.CreateAssessmentSession(_studentProfileId);
        await SessionStorage.SetAsync(SessionIdKey, _session.Id);
    }
}